# ─────────────────────────────────────────────────────────────────────────────
# Lernraum – Konfiguration. scripts/setup-vps.sh legt die .env automatisch an.
# ─────────────────────────────────────────────────────────────────────────────

# Adresse des Lernraums (DNS-A-Record muss auf die VPS-IP zeigen)
DOMAIN=lernraum.example.de
PUBLIC_URL=https://lernraum.example.de

# Login-Passwort für die Oberfläche (und für die Freigabe des Claude-Connectors)
APP_PASSWORD=
# Name für Begrüßung („Guten Abend, Moritz.“) und Initialen
APP_USER_NAME=Moritz Bibow

# Geheimnisse – lange Zufallswerte (z. B. `openssl rand -hex 32`)
SESSION_SECRET=
# Statischer Token für REST-API und Claude Code (Authorization: Bearer …)
LERNRAUM_API_TOKEN=

# Traefik auf dem VPS (setup-vps.sh erkennt diese Werte automatisch)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
# Nur wenn Traefik in einem eigenen Docker-Netzwerk läuft (z. B. n8n-Vorlage):
# TRAEFIK_NETWORK=root_default
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik-net.yml

# Optional
# LERNRAUM_LOCAL_PORT=3100        # Diagnose-Port, nur auf 127.0.0.1
# MCP_URL_SECRET=                 # Notfall: MCP ohne OAuth unter /api/mcp/k/<secret> (mind. 24 Zeichen)
# OAUTH_ALLOWED_REDIRECTS=        # zusätzliche OAuth-Redirect-URIs, Komma-getrennt
# BACKUP_DISABLED=1               # nächtliches Backup abschalten
